    {"name": "ComfyUI", "group": "AI", "side": "win", "port": 11600, "optional": true, "open": "http://127.0.0.1:11600/"},
    {"name": "Ollama (standalone)", "group": "AI", "side": "win", "port": 11434, "optional": true},
    {"name": "Plex", "group": "Media", "side": "win", "port": 32400, "health": "http://127.0.0.1:32400/identity", "every": 60, "open": "http://127.0.0.1:32400/web"},
    {"name": "Jellyfin", "group": "Media", "side": "win", "port": 8096, "health": "http://127.0.0.1:8096/health", "every": 60, "open": "http://127.0.0.1:8096/"},
