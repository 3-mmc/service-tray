    {"name": "Ghidra (MCP)", "group": "MCP", "side": "win", "port": 13100, "optional": true},
    {"name": "Chrome CDP (playwright-cdp)", "group": "MCP", "side": "win", "port": 9222, "optional": true, "health": "http://127.0.0.1:9222/json/version", "every": 60},
