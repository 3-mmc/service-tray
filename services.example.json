    {"name": "Sure", "group": "Homelab", "side": "wsl", "port": 3000, "docker": "sure-web-1", "health": "http://127.0.0.1:3000/up", "open": "http://127.0.0.1:3000/", "restart": "wsl:docker restart sure-web-1"},
    {"name": "Jetlog", "group": "Homelab", "side": "wsl", "port": 3001, "docker": "jetlog", "health": "http://127.0.0.1:3001/", "every": 60, "open": "http://127.0.0.1:3001/", "restart": "wsl:docker restart jetlog"},
    {"name": "KoInsight", "group": "Homelab", "side": "wsl", "port": 3003, "docker": "koinsight", "health": "http://127.0.0.1:3003/", "every": 60, "open": "http://127.0.0.1:3003/", "restart": "wsl:docker restart koinsight"},
    {"name": "BirdNET-Go", "group": "Homelab", "side": "wsl", "port": 3004, "docker": "birdnet-go", "health": "http://127.0.0.1:3004/", "open": "http://127.0.0.1:3004/", "restart": "wsl:docker restart birdnet-go"},
    {"name": "Gramps Web", "group": "Homelab", "side": "wsl", "port": 3005, "docker": "grampsweb-grampsweb-1", "health": "http://127.0.0.1:3005/", "every": 120, "open": "http://127.0.0.1:3005/", "restart": "wsl:docker restart grampsweb-grampsweb-1"},
    {"name": "OpenCiv", "group": "Homelab", "side": "wsl", "port": 2000, "docker": "openciv-proxy-1", "health": "http://127.0.0.1:2000/", "every": 120, "open": "http://127.0.0.1:2000/", "restart": "wsl:docker restart openciv-server-1 openciv-proxy-1"},
