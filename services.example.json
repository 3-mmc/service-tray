{
  "wslDistro": "Debian",
  "windowsEvery": 5,
  "wslEvery": 15,
  "healthEvery": 30,
  "ignoreFrom": 49152,
  "ignorePorts": [53, 135, 139, 445, 902, 912, 2222, 5040, 5357, 8443, 8444, 8445, 8446, 15100, 15101, 27036, 32401],
  "collapseHealthy": false,
  "checkPorts": ["11520-11554", 11600, 11434, 8080],
  "llamaSwap": {"url": "http://127.0.0.1:9292", "service": "llama-swap"},

