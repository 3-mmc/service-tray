{
  "wslDistro": "Debian",
  "windowsEvery": 5,
  "wslEvery": 15,
  "healthEvery": 30,
  "ignoreFrom": 49152,
  "ignorePorts": [53, 135, 139, 445, 902, 912, 2222, 5040, 5357, 8443, 8444, 8445, 8446, 15100, 15101, 27036, 32401],

  "services": [
    { "name": "llama-swap", "side": "win", "port": 9292, "health": "http://127.0.0.1:9292/running", "every": 10,
      "open": "http://127.0.0.1:9292/ui/",
      "restart": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'D:\\llama-swap\\gateway.ps1' stop; & 'D:\\llama-swap\\gateway.ps1' start\"" },
    { "name": "ComfyUI", "side": "win", "port": 11600, "optional": true, "open": "http://127.0.0.1:11600/" },
    { "name": "Ollama (standalone)", "side": "win", "port": 11434, "optional": true },
    { "name": "Plex", "side": "win", "port": 32400, "health": "http://127.0.0.1:32400/identity", "every": 60,
      "open": "http://127.0.0.1:32400/web" },
    { "name": "Jellyfin", "side": "win", "port": 8096, "health": "http://127.0.0.1:8096/health", "every": 60,
      "open": "http://127.0.0.1:8096/" },
    { "name": "Radarr", "side": "win", "port": 7878, "health": "http://127.0.0.1:7878/ping", "every": 120,
      "open": "http://127.0.0.1:7878/" },
    { "name": "Sonarr", "side": "win", "port": 8989, "health": "http://127.0.0.1:8989/ping", "every": 120,
      "open": "http://127.0.0.1:8989/" },
    { "name": "Bazarr", "side": "win", "port": 6767, "health": "http://127.0.0.1:6767/", "every": 120,
      "open": "http://127.0.0.1:6767/" },
    { "name": "Tailscale serve", "side": "win", "port": 443 },
    { "name": "Windows sshd", "side": "win", "port": 22 },
    { "name": "Chrome CDP", "side": "win", "port": 9222, "optional": true },
    { "name": "usbipd", "side": "win", "port": 3240, "optional": true },

    { "name": "Sure", "side": "wsl", "port": 3000, "docker": "sure-web-1", "health": "http://127.0.0.1:3000/up",
      "open": "http://127.0.0.1:3000/", "restart": "wsl:docker restart sure-web-1" },
    { "name": "Jetlog", "side": "wsl", "port": 3001, "docker": "jetlog", "health": "http://127.0.0.1:3001/", "every": 60,
      "open": "http://127.0.0.1:3001/", "restart": "wsl:docker restart jetlog" },
    { "name": "KoInsight", "side": "wsl", "port": 3003, "docker": "koinsight", "health": "http://127.0.0.1:3003/", "every": 60,
      "open": "http://127.0.0.1:3003/", "restart": "wsl:docker restart koinsight" },
    { "name": "BirdNET-Go", "side": "wsl", "port": 3004, "docker": "birdnet-go", "health": "http://127.0.0.1:3004/",
      "open": "http://127.0.0.1:3004/", "restart": "wsl:docker restart birdnet-go" },
    { "name": "Gramps Web", "side": "wsl", "port": 3005, "docker": "grampsweb-grampsweb-1", "health": "http://127.0.0.1:3005/", "every": 120,
      "open": "http://127.0.0.1:3005/", "restart": "wsl:docker restart grampsweb-grampsweb-1" },
    { "name": "OpenCiv", "side": "wsl", "port": 2000, "docker": "openciv-proxy-1", "health": "http://127.0.0.1:2000/", "every": 120,
      "open": "http://127.0.0.1:2000/", "restart": "wsl:docker restart openciv-server-1 openciv-proxy-1" },
    { "name": "WSL sshd", "side": "wsl", "port": 2223 }
  ]
}
