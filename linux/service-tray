                                 "portFrom": self.pfrom.get_value_as_int(), "portTo": self.pto.get_value_as_int()})


def new_menu():
    """No reserved check-mark column: the status dot sits at the edge (Windows kept a gutter)."""
    m = Gtk.Menu()
    m.set_reserve_toggle_size(False)
    m.get_style_context().add_class("service-tray")
    return m


def message(text):
    d = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text=APP)
    d.format_secondary_text(text)
    d.set_keep_above(True)
    d.run()
    d.destroy()


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", APP, title, body], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)


def parse_args(argv):
    args, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if a == "--quit-after":
            args["quit-after"] = argv[i + 1]
            i += 1
        elif a.startswith("--"):
            args[a[2:]] = True
        else:
            sys.exit(f"service-tray: unknown argument {a}")
        i += 1
    return args


def main():
    args = parse_args(sys.argv[1:])
    lock_dir = os.environ.get("XDG_RUNTIME_DIR") or CONF_DIR
    os.makedirs(lock_dir, exist_ok=True)
    lock = open(os.path.join(lock_dir, "service-tray.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("service-tray: already running")
    GLib.set_prgname("service-tray")
    GLib.set_application_name(APP)
    # Theme menu rows are ~30 px; 35 rows would not fit a 1080 p screen.
    css = Gtk.CssProvider()
    css.load_from_data(b"menu.service-tray menuitem { padding: 1px 5px 1px 4px; min-height: 0; }"
                       b" menu.service-tray menuitem.sub { padding: 0 5px 0 4px; border-top-width: 0; border-bottom-width: 0; }"
                       b" menu.service-tray separator { margin-top: 2px; margin-bottom: 2px; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Tray(args)
    Gtk.main()


if __name__ == "__main__":
    main()
